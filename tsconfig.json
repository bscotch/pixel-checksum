{
  "include": ["*.mjs", "*.js", "*.d.ts", "*.ts", "*.mts"],
  "compileOnSave": false,
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node"],
    "useUnknownInCatchVariables": true
  }
}
